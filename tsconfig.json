{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // tsc is a type-checker only — esbuild (scripts/build.mjs) does ALL emitting.
    // Relative imports use explicit .ts extensions so the same source tree
    // resolves identically under tsc, esbuild, and plain `node` with
    // --experimental-strip-types (used by the test runner).
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
