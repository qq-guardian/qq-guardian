# Docker Compose environment for Guardian. Copy to deploy/.env and edit before
# first launch. Never commit the real .env; it is gitignored.
# Usage: docker compose --env-file deploy/.env -f deploy/compose.yaml up -d

# ── Project ───────────────────────────────────────────────────────────────────
# COMPOSE_PROJECT_NAME=qq-guardian
TZ=Asia/Shanghai

# ── SnowLuma ──────────────────────────────────────────────────────────────────
# Required. VNC password for first-time QQ login via noVNC.
VNC_PASSWD=replace-with-a-secure-password

# SNOWLUMA_IMAGE=motricseven7/snowluma:latest
# SNOWLUMA_UID=1000
# SNOWLUMA_GID=1000
# SNOWLUMA_LOG_LEVEL=info
# SNOWLUMA_SCREEN=1920x1080x24
# SNOWLUMA_HOOK_AUTOLOAD=1
# SNOWLUMA_EXTRA_QQ_HOMES=
# SNOWLUMA_QQ_FLAGS=--disable-gpu --disable-software-rasterizer --disable-gpu-compositing

# Host ports for local SnowLuma administration (loopback-only; do not publish).
# NOVNC_HOST_PORT=6081
# SNOWLUMA_WEBUI_HOST_PORT=5099

# ── Guardian ──────────────────────────────────────────────────────────────────
# GUARDIAN_IMAGE=qq-guardian:local

# OneBot transport. The bundled default is service-to-service on the private
# Compose network and is not host-published. If Guardian connects to a
# separately deployed SnowLuma across an untrusted network, configure TLS on
# that remote endpoint and set an explicit encrypted URL, for example:
# SNOWLUMA_WS_URL=wss://your-snowluma-host/
SNOWLUMA_WS_URL=ws://snowluma:3001/
SNOWLUMA_ACCESS_TOKEN=
# SNOWLUMA_TRANSPORT=forward-websocket
# SNOWLUMA_HTTP_URL=http://snowluma:3000/
# SNOWLUMA_WEBHOOK_HOST=0.0.0.0
# SNOWLUMA_WEBHOOK_PORT=6100
# SNOWLUMA_WEBHOOK_PATH=/onebot/events
# SNOWLUMA_REVERSE_WS_HOST=0.0.0.0
# SNOWLUMA_REVERSE_WS_PORT=6101
# SNOWLUMA_REVERSE_WS_PATH=/onebot
# SNOWLUMA_SDK_FALLBACK=auto
# SNOWLUMA_MAX_FRAME_BYTES=1048576
# SNOWLUMA_RAW_QUEUE_LIMIT=64
# SNOWLUMA_RAW_QUEUE_BYTES=8388608

# Guardian WebUI/API is published on host loopback only.
# GUARDIAN_HTTP_HOST_PORT=6099

# Optional first-admin bootstrap (used only while the users table is empty).
# QQ_GUARDIAN_BOOTSTRAP_USERNAME=guardian-admin
# QQ_GUARDIAN_BOOTSTRAP_PASSWORD=replace-with-a-unique-12-plus-character-password
# QQ_GUARDIAN_FORCE_BOOTSTRAP_RECOVERY=0

# ── HTTPS overlay (compose.https.yaml) ───────────────────────────────────────
# Set GUARDIAN_DOMAIN when using the Caddy HTTPS overlay. JWT bearer tokens
# must not cross an untrusted network over plaintext HTTP; always configure TLS
# for any public Guardian endpoint. wss:// or https:// is required for OneBot
# connections that leave the private Compose network.
# GUARDIAN_DOMAIN=guardian.example.com
# GUARDIAN_HTTP_REDIRECT_HOST_PORT=80
# GUARDIAN_HTTPS_HOST_PORT=443

# ── Named volumes ─────────────────────────────────────────────────────────────
# SNOWLUMA_DATA_VOLUME=qq-guardian-snowluma-data
# QQ_CLIENT_CONFIG_VOLUME=qq-guardian-qq-config
# QQ_CLIENT_DATA_VOLUME=qq-guardian-qq-data
# GUARDIAN_DATA_VOLUME=qq-guardian-data
# GUARDIAN_CONFIG_VOLUME=qq-guardian-config
# GUARDIAN_CADDY_DATA_VOLUME=qq-guardian-caddy-data
# GUARDIAN_CADDY_CONFIG_VOLUME=qq-guardian-caddy-config
