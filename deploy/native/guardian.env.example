# Native Guardian environment file. Keep it outside the unpacked release so
# release upgrades never replace persistent paths or secrets.
SNOWLUMA_WS_URL=ws://127.0.0.1:3001/
SNOWLUMA_ACCESS_TOKEN=
# `auto` is native WebSocket first, then the bundled SDK during startup only.
# Set `off` only to diagnose a transport incompatibility.
SNOWLUMA_SDK_FALLBACK=auto
# Native ingress limits: 1 MiB/frame, 64 retained frames, 8 MiB retained raw data.
SNOWLUMA_MAX_FRAME_BYTES=1048576
SNOWLUMA_RAW_QUEUE_LIMIT=64
SNOWLUMA_RAW_QUEUE_BYTES=8388608
QQ_GUARDIAN_HTTP_HOST=127.0.0.1
QQ_GUARDIAN_HTTP_PORT=6099

# Use absolute paths. The service account must own both directories.
QQ_GUARDIAN_DATA_DIR=/var/lib/qq-guardian/data
QQ_GUARDIAN_CONFIG_DIR=/etc/qq-guardian

# Optional unattended first-admin bootstrap, used only while the users table
# is empty. Keep this owner-only and never commit it; otherwise read the local
# data/bootstrap-credentials.json once after first boot.
# QQ_GUARDIAN_BOOTSTRAP_USERNAME=guardian-admin
# QQ_GUARDIAN_BOOTSTRAP_PASSWORD=replace-with-a-unique-12-plus-character-password
# Break-glass recovery only; requires both explicit values above and fails
# closed when either is missing or invalid. Remove after one audited start.
# QQ_GUARDIAN_FORCE_BOOTSTRAP_RECOVERY=1

# Security-sensitive and disabled by default. Set only for a trusted private
# OpenAI-compatible endpoint when Guardian ai.provider is custom.
# QQ_GUARDIAN_ALLOW_PRIVATE_AI_ENDPOINTS=true
